# ============================================================
# BootZone Server Environment Configuration
# File: server/.env
# Copy to .env and update values for your environment
# ============================================================

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bootzone

# JWT
JWT_SECRET=bootzone_super_secret_key_change_in_production_2024
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
